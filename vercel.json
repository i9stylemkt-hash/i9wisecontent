{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/generate-content",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/check-calendar",
      "schedule": "0 7 * * *"
    }
  ]
}